# Copy to .env.test (not committed). Used only by the e2e tests.
# The database name MUST end in _test: it is emptied on every test run.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk_test?schema=public"

# Any random string of 32+ characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-to-a-random-32+-char-string"

# Users created in the test database. Passwords need at least 8 characters.
E2E_ADMIN_EMAIL="e2e-admin@example.com"
E2E_ADMIN_PASSWORD="change-me-test-admin"
E2E_AGENT_EMAIL="e2e-agent@example.com"
E2E_AGENT_PASSWORD="change-me-test-agent"
